generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum CountryRegion {
  EUROPE
  ASIA
  AFRICA
  AMERICAS
  OCEANIA
}

enum GameMode {
  DAILY
  FREEPLAY
}

enum SessionStatus {
  IN_PROGRESS
  WON
  GAVE_UP
}

model Country {
  iso2         String        @id @db.Char(2)
  nameEn       String        @map("name_en") @db.VarChar(120)
  capital      String?       @db.VarChar(120)
  region       CountryRegion
  subregion    String        @db.VarChar(80)
  population   Int
  areaKm2      Float         @map("area_km2")
  isLandlocked Boolean       @map("is_landlocked")
  avgTempC     Float         @map("avg_temp_c")
  flagEmoji    String        @map("flag_emoji") @db.VarChar(16)
  lat          Float
  lng          Float

  aliases         CountryAlias[]
  neighborsFrom   CountryNeighbor[] @relation("NeighborFrom")
  neighborsTo     CountryNeighbor[] @relation("NeighborTo")
  dailyChallenges DailyChallenge[]
  secretSessions  GameSession[]
  guesses         GeodleGuess[]

  @@map("countries")
}

model CountryAlias {
  id              Int     @id @default(autoincrement())
  countryIso2     String  @map("country_iso2") @db.Char(2)
  alias           String  @db.VarChar(160)
  aliasNormalized String  @map("alias_normalized") @db.VarChar(160)
  country         Country @relation(fields: [countryIso2], references: [iso2], onDelete: Cascade)

  @@index([aliasNormalized])
  @@index([countryIso2])
  @@map("country_aliases")
}

model CountryNeighbor {
  countryIso2  String  @map("country_iso2") @db.Char(2)
  neighborIso2 String  @map("neighbor_iso2") @db.Char(2)
  country      Country @relation("NeighborFrom", fields: [countryIso2], references: [iso2], onDelete: Cascade)
  neighbor     Country @relation("NeighborTo", fields: [neighborIso2], references: [iso2], onDelete: Cascade)

  @@id([countryIso2, neighborIso2])
  @@map("country_neighbors")
}

model DailyChallenge {
  id                Int      @id @default(autoincrement())
  challengeNumber   Int      @unique @map("challenge_number")
  challengeDate     DateTime @unique @map("challenge_date") @db.Date
  secretCountryIso2 String   @map("secret_country_iso2") @db.Char(2)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  secretCountry Country       @relation(fields: [secretCountryIso2], references: [iso2])
  sessions      GameSession[]

  @@map("daily_challenges")
}

model GameSession {
  id                String        @id @default(uuid()) @db.Uuid
  guestId           String        @map("guest_id") @db.Uuid
  mode              GameMode
  dailyChallengeId  Int?          @map("daily_challenge_id")
  secretCountryIso2 String        @map("secret_country_iso2") @db.Char(2)
  status            SessionStatus @default(IN_PROGRESS)
  guessCount        Int           @default(0) @map("guess_count")
  startedAt         DateTime      @default(now()) @map("started_at") @db.Timestamptz(6)
  endedAt           DateTime?     @map("ended_at") @db.Timestamptz(6)

  dailyChallenge DailyChallenge? @relation(fields: [dailyChallengeId], references: [id], onDelete: Cascade)
  secretCountry  Country         @relation(fields: [secretCountryIso2], references: [iso2])
  guesses        GeodleGuess[]

  @@unique([guestId, dailyChallengeId])
  @@index([guestId])
  @@map("game_sessions")
}

model GeodleGuess {
  id                 String   @id @default(uuid()) @db.Uuid
  sessionId          String   @map("session_id") @db.Uuid
  guessOrder         Int      @map("guess_order")
  guessedCountryIso2 String   @map("guessed_country_iso2") @db.Char(2)
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  session        GameSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  guessedCountry Country     @relation(fields: [guessedCountryIso2], references: [iso2])

  @@unique([sessionId, guessedCountryIso2])
  @@unique([sessionId, guessOrder])
  @@map("geodle_guesses")
}
